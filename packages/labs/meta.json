[
  {
    "id": "smart-icon",
    "name": "SmartIcon",
    "package": "@supermousejs/labs",
    "description": "Advanced state machine that morphs SVGs based on semantic context.",
    "code": "import { SmartIcon } from '@supermousejs/labs';\n\napp.use(SmartIcon({ icons: { ... } }));",
    "recipeId": "context-icon",
    "icon": "labs",
    "options": [
      {
        "name": "icons",
        "type": "Record<string, string>",
        "default": "{}",
        "description": "Map of state names to SVG strings.",
        "reactive": false
      },
      {
        "name": "defaultState",
        "type": "string",
        "default": "'default'",
        "description": "Initial semantic state used before any hover interaction resolves.",
        "reactive": false
      },
      {
        "name": "useSemanticTags",
        "type": "boolean",
        "default": "true",
        "description": "Resolve smart states from semantic HTML tags such as links and buttons.",
        "reactive": false
      },
      {
        "name": "transitionDuration",
        "type": "number",
        "default": "200",
        "description": "Morph transition time in ms.",
        "reactive": false
      },
      {
        "name": "switchDelay",
        "type": "number",
        "default": "80",
        "description": "Minimum ms a state must be requested before committing to the next icon.",
        "reactive": false
      },
      {
        "name": "size",
        "type": "number",
        "default": "24",
        "description": "Size of the icon container.",
        "reactive": true
      },
      {
        "name": "color",
        "type": "string",
        "default": "'black'",
        "description": "Icon fill color (currentColor).",
        "reactive": true
      },
      {
        "name": "offset",
        "type": "[number, number]",
        "default": "[0, 0]",
        "description": "Fixed offset.",
        "reactive": false
      },
      {
        "name": "anchor",
        "type": "string",
        "default": "'center'",
        "description": "Alignment (center, top-left, etc).",
        "reactive": true
      },
      {
        "name": "followStrategy",
        "type": "'smooth' | 'raw'",
        "default": "'smooth'",
        "description": "Whether the icon should smoothly follow the pointer or snap to it.",
        "reactive": true
      },
      {
        "name": "rotateWithVelocity",
        "type": "boolean",
        "default": "false",
        "description": "Rotate the icon based on movement velocity.",
        "reactive": true
      }
    ]
  },
  {
    "id": "smart-ring",
    "name": "SmartRing",
    "package": "@supermousejs/labs",
    "description": "A reactive ring that distorts with velocity and adapts to stuck elements.",
    "code": "import { SmartRing } from '@supermousejs/labs';\n\napp.use(SmartRing({ size: 24, color: '#f59e0b', enableSkew: true }));",
    "icon": "ring",
    "options": [
      {
        "name": "size",
        "type": "number",
        "default": "20",
        "description": "Base diameter.",
        "reactive": true
      },
      {
        "name": "hoverSize",
        "type": "number",
        "default": "40",
        "description": "Diameter on hover.",
        "reactive": true
      },
      {
        "name": "color",
        "type": "string",
        "default": "'#ffffff'",
        "description": "Border color used for the ring.",
        "reactive": true
      },
      {
        "name": "fill",
        "type": "string",
        "default": "'transparent'",
        "description": "Background fill color applied to the ring.",
        "reactive": true
      },
      {
        "name": "borderWidth",
        "type": "number",
        "default": "2",
        "description": "Border thickness in pixels.",
        "reactive": true
      },
      {
        "name": "mixBlendMode",
        "type": "string",
        "default": "'difference'",
        "description": "CSS mix-blend-mode applied to the ring element.",
        "reactive": false
      },
      {
        "name": "enableSkew",
        "type": "boolean",
        "default": "false",
        "description": "Distort shape based on velocity.",
        "reactive": false
      }
    ]
  },
  {
    "id": "sparkles",
    "name": "Sparkles",
    "package": "@supermousejs/labs",
    "description": "Emits particle trails based on movement velocity.",
    "code": "import { Sparkles } from '@supermousejs/labs';\n\napp.use(Sparkles({ color: '#f59e0b', frequency: 10 }));",
    "icon": "trail",
    "options": [
      {
        "name": "color",
        "type": "string",
        "default": "'#ff00ff'",
        "description": "Particle color.",
        "reactive": true
      },
      {
        "name": "count",
        "type": "number",
        "default": "30",
        "description": "Number of particles to keep in the pool.",
        "reactive": false
      },
      {
        "name": "frequency",
        "type": "number",
        "default": "10",
        "description": "Pixels per spawn.",
        "reactive": false
      },
      {
        "name": "decay",
        "type": "number",
        "default": "0.05",
        "description": "Fade rate.",
        "reactive": false
      },
      {
        "name": "scatter",
        "type": "number",
        "default": "5",
        "description": "Random position offset for particle spawning.",
        "reactive": false
      }
    ]
  },
  {
    "id": "text-ring",
    "name": "TextRing",
    "package": "@supermousejs/labs",
    "description": "Rotates text around the cursor position.",
    "code": "import { TextRing } from '@supermousejs/labs';\n\napp.use(TextRing({ text: 'LOADING • ', radius: 40 }));",
    "icon": "text",
    "options": [
      {
        "name": "text",
        "type": "string",
        "default": "'SUPERMOUSE • SUPERMOUSE • '",
        "description": "Text content.",
        "reactive": true
      },
      {
        "name": "radius",
        "type": "number",
        "default": "60",
        "description": "Ring radius.",
        "reactive": true
      },
      {
        "name": "fontSize",
        "type": "number",
        "default": "12",
        "description": "Text size in pixels.",
        "reactive": true
      },
      {
        "name": "speed",
        "type": "number",
        "default": "0.5",
        "description": "Rotation speed deg/frame.",
        "reactive": true
      },
      {
        "name": "color",
        "type": "string",
        "default": "'currentColor'",
        "description": "Text color used by the SVG ring.",
        "reactive": true
      },
      {
        "name": "opacity",
        "type": "number",
        "default": "1",
        "description": "Opacity of the rendered ring container.",
        "reactive": true
      },
      {
        "name": "className",
        "type": "string",
        "default": "''",
        "description": "Optional CSS class added to the container.",
        "reactive": false
      },
      {
        "name": "spread",
        "type": "boolean",
        "default": "false",
        "description": "Stretch the text to fit around the full loop.",
        "reactive": false
      }
    ]
  }
]
